# Copy to `.env` and adjust. Docker Compose and the app both read this file.
#   cp .env.example .env

# ---- Postgres -------------------------------------------------------------
# Local Docker default. For Supabase/Neon, paste their connection string here
# and set PGSSLMODE=require (hosted Postgres requires TLS).
DATABASE_URL=postgres://cardindex:cardindex@localhost:5435/cardindex
PGSSLMODE=disable

# Used by docker-compose to provision the local db (keep in sync with DATABASE_URL).
# Host port is 5435 to avoid your other project DBs (jk_crm 5432, mechanic 5433,
# doctor85 5544); inside the container Postgres still listens on 5432.
POSTGRES_USER=cardindex
POSTGRES_PASSWORD=cardindex
POSTGRES_DB=cardindex
POSTGRES_PORT=5435

# ---- Image storage / bucket ----------------------------------------------
# local = write files under ./data/uploads (zero-dependency, good for dev)
# s3    = any S3-compatible bucket: MinIO (below), AWS S3, Cloudflare R2, or
#         Supabase Storage's S3 endpoint. Requires: npm i @aws-sdk/client-s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_BASE=/uploads

# S3-compatible settings (used when STORAGE_DRIVER=s3). Defaults match the
# bundled MinIO service in docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=card-images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL for serving stored images to customers:
S3_PUBLIC_BASE=http://localhost:9000/card-images
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Vision identification (photo → card) ---------------------------------
# How an uploaded card photo is recognized (see src/app/vision.ts). Whatever a
# provider returns is resolved against the catalog by the same matcher used for
# typed input, so it becomes a priced variant with alternatives + confidence.
#   hash  = LOCAL perceptual-hash matcher over catalog reference images — a
#           real working identifier with no external service. Build/refresh
#           the index with `npm run hash:catalog` (re-run after catalog syncs;
#           new sets = new hashes, no retraining). Verified: survives resize +
#           heavy JPEG recompression + small crops; near-ties and junk photos
#           route to the review queue. The server also fills any gap in the
#           index at boot (hosted deploys can't run the script by hand);
#           HASH_INDEX_ON_BOOT=0 turns that off (e.g. all but one instance).
#   none  = no model; fall back to the filename hint (works offline)
#   mock  = return fixed labels for any image (VISION_MOCK_HINT) — for testing
#   http  = POST the image to a recognition API and map its JSON response
#           (http | custom | ximilar select the auth-prefix default)
VISION_PROVIDER=hash

# mock provider:
# VISION_MOCK_HINT=Charizard 4/102 Holo
# VISION_MOCK_CONFIDENCE=0.97

# http provider (e.g. Ximilar card recognition, a self-hosted model, etc.):
# VISION_API_URL=https://api.ximilar.com/collectibles/v2/tcg_id
# VISION_API_KEY=your-key
# VISION_AUTH_HEADER=Authorization
# VISION_AUTH_PREFIX=Token            # Ximilar uses "Token "; most APIs "Bearer "
# VISION_IMAGE_FIELD=image            # JSON field that carries the base64 image
# VISION_TIMEOUT_MS=12000
# Map the response JSON to card fields with dot-paths ('*' = first array item):
# VISION_MAP_NAME=records.*.name
# VISION_MAP_NUMBER=records.*.card_number
# VISION_MAP_SET=records.*.set
# VISION_MAP_CONFIDENCE=records.*.confidence

# ---- eBay Browse API (live "Listed on eBay" panel on card pages) ----------
# Free + self-serve (no partnership needed; research report §3): register at
# https://developer.ebay.com -> create an application keyset -> paste the
# App ID / Cert ID here. Without these the panel is hidden (the "eBay listed"
# link-out button still works). Sold prices are NOT available this way — that
# is the sold_sales archive + import:sold. The public /sales lookup shows REAL
# sales only; at boot the server removes any bundled sample rows. For a
# demo/dev deploy, SOLD_SAMPLE_ON_BOOT=1 instead loads db/sold_sample.csv
# (demo-flagged) whenever the archive is empty.
# EBAY_CLIENT_ID=your-app-id
# EBAY_CLIENT_SECRET=your-cert-id
# EBAY_ENV=production            # or sandbox (sandbox keys + sandbox host)
# EBAY_MARKETPLACE=EBAY_US       # buyer marketplace: EBAY_AU, EBAY_GB, ...
# EBAY_MOCK=1                    # canned listings, no keys needed (UI testing)

# ---- Graded slabs (cert lookup) --------------------------------------------
# none = certs are kept on the review item and the member picks card + grade
# mock = deterministic fake lookups so the graded flow can be exercised offline
# CERT_PROVIDER=none

# ---- TCGplayer API (per-condition "TCGplayer by condition" panel) ----------
# UNLIKE eBay there is no self-serve signup: TCGplayer's developer program is
# closed to new applicants (research report §4). These keys are for a
# grandfathered or partner keyset only — with one, card pages grow SKU-level
# NM/LP/MP/HP prices. Without one you still get product-level market/low/mid/
# high daily via `npm run sync:tcgcsv` (TCGCSV mirror, no keys needed), and
# JustTCG/Scrydex are the commercial per-condition alternatives.
# TCGPLAYER_PUBLIC_KEY=your-public-key
# TCGPLAYER_PRIVATE_KEY=your-private-key
# TCGPLAYER_API_VERSION=v1.39.0
# TCGPLAYER_MOCK=1               # canned condition rows, no keys (UI testing)

# ---- Owner console (/admin) -----------------------------------------------
# The operator's OWN login — separate from member accounts, with its own
# sign-in page (/admin/login) and its own session cookie. No member account
# can reach /admin. The console shows every member with Free vs Pro tier, the
# activity log and feedback, flips a member's plan, and opens any member's
# collection in "owner mode". The owner also gets their OWN member account
# (created on boot for ADMIN_EMAIL — or the existing account with that email):
# /admin/upload and the owner's /collection add cards to that account only,
# never to a member's. Both values are required; without them /admin is
# disabled. Use a long, unique password.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=change-me-to-a-long-random-string

# ---- Email (password-reset links, wishlist price alerts) -------------------
# log    = default; the message (and the reset link) is printed to the server
#          log, so the whole reset flow works locally without an email account.
#          Wishlist alerts (Pro; sent after each `npm run sync:tcgcsv`) go the
#          same way.
# resend = send through https://resend.com — zero dependencies, called with
#          fetch. Verify a sending domain there, then:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=CardIndex <no-reply@yourdomain.com>
# Public origin used inside emailed links (set on Railway; falls back to the
# request's own origin, which is wrong behind a TLS-terminating proxy):
# APP_BASE_URL=https://tradingcardloader.com

# ---- Accounts / sessions --------------------------------------------------
# Login uses HttpOnly session cookies. In production behind HTTPS, set this to 1
# so the cookie carries the Secure flag. Leave unset/0 for local http on
# localhost (a Secure cookie would be dropped over http).
# COOKIE_SECURE=1
